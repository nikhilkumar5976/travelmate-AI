# TravelMate AI Environment Variables

# Django Secret Key & Debug
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (optional for production, defaults to SQLite)
DATABASE_URL=postgresql://user:password@host:port/database

# Gemini GenAI
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash

# Email Configuration (Gmail SMTP or Transactional Email Service)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=TravelMate AI <your-email@gmail.com>

# Site URL for absolute links
SITE_URL=http://localhost:8000

